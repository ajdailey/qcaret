<?xml version="1.0" encoding="UTF-8"?>
<!-- C23 (ISO/IEC 9899:2024) clause 6.4 with the Objective-C additions in the Clang documentation (Objective-C literals, ARC and nullability) and Apple's Programming with Objective-C. -->
<grammar id="objectivec" name="Objective-C" version="1" category="programming">
  <detect>
    <extension>m</extension>
    <extension>mm</extension>
  </detect>
  <comments line="//" blockStart="/*" blockEnd="*/"/>
  <brackets>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
  </brackets>
  <autoClose>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
    <pair open='"' close='"'/>
    <pair open="'" close="'"/>
  </autoClose>
  <indent increase="[{(\[]\s*(//.*)?$|^\s*@(?:interface|implementation|protocol)\b(?!.*;\s*$)" decrease="^\s*(?:[})\]]|@end\b)"/>
  <folding mode="brackets" open="{" close="}"/>
  <symbols>
    <symbol kind="macro" regex="^\s*#\s*define\s+([A-Za-z_]\w*)"/>
    <symbol kind="struct" regex="\bstruct\s+([A-Za-z_]\w*)\s*(?:\{|$)"/>
    <symbol kind="struct" regex="\bunion\s+([A-Za-z_]\w*)\s*(?:\{|$)"/>
    <symbol kind="enum" regex="\benum\s+([A-Za-z_]\w*)\s*(?:\{|$)"/>
    <symbol kind="type" regex="^\s*typedef\b.*?\b([A-Za-z_]\w*)\s*(?:\[[^\]]*\]\s*)*;\s*$"/>
    <symbol kind="class" regex="^\s*@interface\s+(\w+)"/>
    <symbol kind="class" regex="^\s*@implementation\s+(\w+)"/>
    <symbol kind="interface" regex="^\s*@protocol\s+(\w+)\b(?!\s*;)"/>
    <symbol kind="method" regex="^\s*[-+]\s*\([^)]*\)\s*(\w+)"/>
    <symbol kind="function" regex="^(?!(?:if|for|while|switch|return|else|do|case|goto|typedef)\b)[A-Za-z_][\w\s*]*?[\s*]+([A-Za-z_]\w*)\s*\([^;]*$"/>
  </symbols>
  <context id="main">
    <span token="comment" begin="/\*" end="\*/" multiLine="true"/>
    <span token="comment" begin="//"/>
    <match token="preprocessor" regex="^\s*#\s*[A-Za-z_]\w*"/>
    <match token="string" regex="(?&lt;=(?:include|import)\s{0,8})&lt;[^&gt;]*&gt;"/>
    <span token="string" begin='(?:@|u8|[uUL])?"' end='"' escape="\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)"/>
    <span token="string" begin="(?:u8|[uUL])?'" end="'" escape="\\(?:x[0-9A-Fa-f]+|[0-7]{1,3}|u[0-9A-Fa-f]{4}|U[0-9A-Fa-f]{8}|.)"/>
    <match token="keyword" regex="@(?:interface|implementation|protocol|end|class|property|synthesize|dynamic|selector|encode|optional|required|public|private|protected|package|try|catch|finally|throw|autoreleasepool|synchronized|import|available|defs|compatibility_alias)\b"/>
    <match token="constant" regex="@(?:YES|NO|true|false)\b"/>
    <match token="operator" regex="@(?=[\[{(\d-])"/>
    <keywords token="keyword">auto break case const constexpr continue default do else enum extern for goto if inline register restrict return sizeof static struct switch typedef typeof union volatile while self super in out inout bycopy byref oneway nonatomic atomic strong weak copy assign retain readonly readwrite getter setter nullable nonnull null_unspecified null_resettable __block __weak __strong __unsafe_unretained __autoreleasing __bridge __bridge_transfer __bridge_retained __kindof _Nullable _Nonnull</keywords>
    <keywords token="type">bool char double float int long short signed unsigned void id instancetype SEL IMP BOOL Class Protocol NSInteger NSUInteger CGFloat size_t int8_t int16_t int32_t int64_t uint8_t uint16_t uint32_t uint64_t</keywords>
    <keywords token="constant">YES NO nil Nil NULL true false</keywords>
    <match token="number" regex="(?&lt;![\w.])(?:0[xX][0-9A-Fa-f']*\.?[0-9A-Fa-f']*(?:[pP][+-]?\d+)?|0[bB][01']+|\d[\d']*\.?[\d']*(?:[eE][+-]?\d+)?|\.\d[\d']*(?:[eE][+-]?\d+)?)[uUlLfF]*(?!\w)"/>
    <match token="function" regex="(?&lt;!\w)[A-Za-z_]\w*(?=\s*\()"/>
    <match token="type" regex="(?&lt;!\w)[A-Z]\w*[a-z]\w*"/>
    <match token="constant" regex="(?&lt;!\w)[A-Z][A-Z0-9_]+(?!\w)"/>
    <match token="operator" regex="[-+*/%=&amp;|!&lt;&gt;^~?:]+"/>
    <match token="delimiter" regex="[{}()\[\];,.]"/>
  </context>
</grammar>
