<?xml version="1.0" encoding="UTF-8"?>
<!-- ECMAScript 2024 (ECMA-262, 15th edition), clause 12 (lexical grammar). -->
<grammar id="javascript" name="JavaScript" version="1">
  <detect>
    <extension>js</extension>
    <extension>mjs</extension>
    <extension>cjs</extension>
    <extension>jsx</extension>
    <firstLine>^#!.*\bnode\b</firstLine>
  </detect>
  <comments line="//" blockStart="/*" blockEnd="*/"/>
  <brackets>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
  </brackets>
  <autoClose>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
    <pair open='"' close='"'/>
    <pair open="'" close="'"/>
    <pair open="`" close="`"/>
  </autoClose>
  <indent increase="[{(\[]\s*(//.*)?$" decrease="^\s*[})\]]"/>
  <folding mode="brackets" open="{[" close="}]"/>
  <context id="main">
    <span token="comment" begin="/\*" end="\*/" multiLine="true"/>
    <span token="comment" begin="//"/>
    <span token="string" begin='"' end='"' escape="\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\{[0-9A-Fa-f]+\}|.)"/>
    <span token="string" begin="'" end="'" escape="\\(?:x[0-9A-Fa-f]{2}|u[0-9A-Fa-f]{4}|u\{[0-9A-Fa-f]+\}|.)"/>
    <span token="string" begin="`" end="`" escape="\\." context="template" multiLine="true"/>
    <match token="string" regex="(?&lt;=^|[(,=:\[!&amp;|?{};]|\breturn|\btypeof)\s*/(?![*/])(?:\\.|\[(?:\\.|[^\]\\])*\]|[^/\\\[])+/[dgimsuvy]*"/>
    <match token="preprocessor" regex="@[A-Za-z_$][\w$]*"/>
    <keywords token="keyword" wordChars="_$">as async await break case catch class const continue debugger default delete do else export extends finally for from function get if import in instanceof let new of return set static super switch this throw try typeof var void while with yield</keywords>
    <keywords token="constant" wordChars="_$">true false null undefined NaN Infinity</keywords>
    <match token="number" regex="(?&lt;![\w$.])(?:0[xX][0-9A-Fa-f_]+n?|0[oO][0-7_]+n?|0[bB][01_]+n?|\d[\d_]*n|(?:\d[\d_]*\.?[\d_]*|\.\d[\d_]*)(?:[eE][+-]?\d[\d_]*)?)(?![\w$])"/>
    <match token="function" regex="(?&lt;![\w$])[A-Za-z_$][\w$]*(?=\s*\()"/>
    <match token="type" regex="(?&lt;![\w$])[A-Z][\w$]*[a-z][\w$]*"/>
    <match token="constant" regex="(?&lt;![\w$])[A-Z][A-Z0-9_]+(?![\w$])"/>
    <match token="operator" regex="[-+*/%=&amp;|!&lt;&gt;^~?:]+|\.\.\."/>
    <match token="delimiter" regex="[{}()\[\];,.]"/>
  </context>
  <context id="template">
    <match token="delimiter" regex="\$\{" push="substitution"/>
  </context>
  <context id="substitution">
    <match token="delimiter" regex="\}" pop="true"/>
    <include context="main"/>
  </context>
</grammar>
