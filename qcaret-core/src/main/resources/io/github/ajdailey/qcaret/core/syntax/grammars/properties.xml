<?xml version="1.0" encoding="UTF-8"?>
<!-- Java properties files, as java.util.Properties.load(Reader) reads them. -->
<grammar id="properties" name="Properties" version="1" category="build">
  <detect>
    <extension>properties</extension>
  </detect>
  <comments line="#"/>
  <context id="main">
    <span token="comment" begin="^\s*[#!]"/>
    <match token="attribute" regex="^\s*(?:\\.|[^\s=:\\])+"/>
    <span token="string" begin="\s*[=:]\s*|\s+" end="(?&lt;!(?&lt;!\\)\\(?:\\\\){0,100})$" escape="\\(?:u[0-9A-Fa-f]{4}|.)" multiLine="true"/>
  </context>
</grammar>
