<?xml version="1.0" encoding="UTF-8"?>
<!-- Scala 3 Language Reference, chapter 1 (lexical syntax), with the Scala 3 syntax summary's soft keywords and string interpolation. -->
<grammar id="scala" name="Scala" version="1">
  <detect>
    <extension>scala</extension>
    <extension>sc</extension>
    <firstLine>^#!.*\bscala(?:-cli)?\b</firstLine>
  </detect>
  <comments line="//" blockStart="/*" blockEnd="*/"/>
  <brackets>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
  </brackets>
  <autoClose>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
    <pair open='"' close='"'/>
  </autoClose>
  <indent increase="(?:[{(\[]|=&gt;|=|:|\b(?:then|else|do|yield|match|try|catch|finally|with))\s*(//.*)?$" decrease="^\s*(?:[})\]]|end\b)"/>
  <folding mode="indent"/>
  <context id="main">
    <span token="comment" begin="^#!"/>
    <span token="comment" begin="/\*" end="\*/" multiLine="true" nested="true"/>
    <span token="comment" begin="//"/>
    <span token="string" begin='(?&lt;![\w$])[A-Za-z_]\w*"""' end='"""(?!")' context="interpolation" multiLine="true"/>
    <span token="string" begin='"""' end='"""(?!")' multiLine="true"/>
    <span token="string" begin='(?&lt;![\w$])[A-Za-z_]\w*"' end='"' escape="\\(?:u+[0-9A-Fa-f]{4}|.)|\$\$" context="interpolation"/>
    <span token="string" begin='"' end='"' escape="\\(?:u+[0-9A-Fa-f]{4}|[0-7]{1,3}|.)"/>
    <match token="string" regex="'(?:\\(?:u+[0-9A-Fa-f]{4}|.)|[^'\\])'"/>
    <match token="constant" regex="'[A-Za-z_]\w*"/>
    <match token="preprocessor" regex="@[A-Za-z_][\w.]*"/>
    <match regex="`[^`]+`"/>
    <keywords token="keyword" wordChars="_$">abstract case catch class def do else enum export extends final finally for given if implicit import lazy match new object override package private protected return sealed super then throw trait try type val var while with yield as derives end extension infix inline opaque open transparent using this forSome macro</keywords>
    <keywords token="constant" wordChars="_$">true false null</keywords>
    <match token="number" regex="(?&lt;![\w$.])(?:0[xX][0-9A-Fa-f_]+|\d[\d_]*\.?[\d_]*(?:[eE][+-]?\d[\d_]*)?|\.\d[\d_]*(?:[eE][+-]?\d[\d_]*)?)[lLfFdD]?(?![\w$])"/>
    <match token="function" regex="(?&lt;=\bdef\s{1,8})[A-Za-z_][\w$]*"/>
    <match token="type" regex="(?&lt;![\w$])[A-Z][\w$]*"/>
    <match token="function" regex="(?&lt;![\w$])[a-z_][\w$]*(?=\s*(?:\[[^\[\]]*\]\s*)?\()"/>
    <match token="operator" regex="[-+*/%=&amp;|!&lt;&gt;^~?:#@\\]+"/>
    <match token="delimiter" regex="[{}()\[\];,.]"/>
  </context>
  <context id="interpolation">
    <match token="constant" regex="\$[A-Za-z_]\w*"/>
    <match token="delimiter" regex="\$\{" push="substitution"/>
  </context>
  <context id="substitution">
    <match token="delimiter" regex="\}" pop="true"/>
    <include context="main"/>
  </context>
</grammar>
