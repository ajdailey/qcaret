<?xml version="1.0" encoding="UTF-8"?>
<!-- PHP 8.3 manual, Language Reference (basic syntax, types, strings, attributes) and the list of keywords; text outside PHP tags uses the HTML grammar. -->
<grammar id="php" name="PHP" version="1" category="programming">
  <detect>
    <extension>php</extension>
    <extension>phtml</extension>
    <extension>php3</extension>
    <extension>php4</extension>
    <extension>php5</extension>
    <extension>php7</extension>
    <extension>php8</extension>
    <extension>phps</extension>
    <firstLine>^(?:#!.*\bphp[0-9.]*\b|&lt;\?php\b)</firstLine>
  </detect>
  <comments line="//" blockStart="/*" blockEnd="*/"/>
  <brackets>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
  </brackets>
  <autoClose>
    <pair open="(" close=")"/>
    <pair open="[" close="]"/>
    <pair open="{" close="}"/>
    <pair open='"' close='"'/>
    <pair open="'" close="'"/>
  </autoClose>
  <indent increase="[{(\[:]\s*(//.*|#.*)?$" decrease="^\s*(?:[})\]]|(?:endif|endwhile|endfor|endforeach|endswitch|else|elseif)\b)"/>
  <folding mode="brackets" open="{" close="}"/>
  <symbols>
    <symbol kind="method" regex="(?i)^\s*(?:(?:public|protected|private|static|abstract|final)\s+)+function\s+&amp;?([\p{L}_][\p{L}\p{N}_]*)"/>
    <symbol kind="function" regex="(?i)\bfunction\s+&amp;?([\p{L}_][\p{L}\p{N}_]*)\s*\("/>
    <symbol kind="class" regex="(?i)\bclass\s+([\p{L}_][\p{L}\p{N}_]*)"/>
    <symbol kind="interface" regex="(?i)\binterface\s+([\p{L}_][\p{L}\p{N}_]*)"/>
    <symbol kind="trait" regex="(?i)\btrait\s+([\p{L}_][\p{L}\p{N}_]*)"/>
    <symbol kind="enum" regex="(?i)\benum\s+([\p{L}_][\p{L}\p{N}_]*)"/>
    <symbol kind="namespace" regex="(?i)^\s*namespace\s+([\p{L}_\\][\p{L}\p{N}_\\]*)"/>
    <symbol kind="constant" regex="(?i)^\s*(?:(?:public|protected|private|final)\s+)*const\s+(?:[\p{L}_][\p{L}\p{N}_]*\s+)?([\p{L}_][\p{L}\p{N}_]*)\s*="/>
  </symbols>
  <context id="main">
    <span token="comment" begin="^#!"/>
    <match token="preprocessor" regex="&lt;\?(?:php\b|=)?" push="code"/>
    <embed grammar="html" begin="(?=[\s\S])" end="(?=&lt;\?)"/>
  </context>
  <context id="code">
    <match token="preprocessor" regex="\?&gt;" pop="true"/>
    <span token="comment" begin="/\*" end="\*/" multiLine="true"/>
    <span token="comment" begin="//|#(?!\[)" end="(?=\?&gt;)"/>
    <span token="preprocessor" begin="#\[" end="\]" context="attribute" multiLine="true"/>
    <span token="string" begin="&lt;&lt;&lt;[ \t]*'([A-Za-z_]\w*)'" end="^\s*\1\b" multiLine="true" bodyNextLine="true"/>
    <span token="string" begin="&lt;&lt;&lt;[ \t]*&quot;?([A-Za-z_]\w*)&quot;?" end="^\s*\1\b" escape="\\(?:[nrtvef\\$&quot;]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u\{[0-9A-Fa-f]+\})" context="interpolation" multiLine="true" bodyNextLine="true"/>
    <span token="string" begin='"' end='"' escape="\\(?:[nrtvef\\$&quot;]|[0-7]{1,3}|x[0-9A-Fa-f]{1,2}|u\{[0-9A-Fa-f]+\})" context="interpolation" multiLine="true"/>
    <span token="string" begin="`" end="`" escape="\\." context="interpolation" multiLine="true"/>
    <span token="string" begin="'" end="'" escape="\\[\\']" multiLine="true"/>
    <match token="keyword2" regex="\$+[A-Za-z_]\w*"/>
    <keywords token="keyword" ignoreCase="true">abstract and array as break callable case catch class clone const continue declare default do echo else elseif empty enddeclare endfor endforeach endif endswitch endwhile enum eval exit extends final finally fn for foreach function global goto if implements include include_once instanceof insteadof interface isset list match namespace new or print private protected public readonly require require_once return static switch throw trait try unset use var while xor yield die</keywords>
    <keywords token="type" ignoreCase="true">bool int float string object mixed void never iterable null self parent</keywords>
    <keywords token="constant" ignoreCase="true">true false __CLASS__ __DIR__ __FILE__ __FUNCTION__ __LINE__ __METHOD__ __NAMESPACE__ __TRAIT__</keywords>
    <match token="number" regex="(?&lt;![\w.$])(?:0[xX][0-9A-Fa-f_]+|0[bB][01_]+|0[oO][0-7_]+|\d[\d_]*\.?[\d_]*(?:[eE][+-]?\d[\d_]*)?|\.\d[\d_]*(?:[eE][+-]?\d[\d_]*)?)(?!\w)"/>
    <match token="function" regex="(?&lt;![\w$])[A-Za-z_]\w*(?=\s*\()"/>
    <match token="type" regex="(?&lt;![\w$])[A-Z]\w*[a-z]\w*"/>
    <match token="constant" regex="(?&lt;![\w$])[A-Z][A-Z0-9_]+(?!\w)"/>
    <match token="operator" regex="[-+*/%=&amp;|!&lt;&gt;^~?:@.]+"/>
    <match token="delimiter" regex="[{}()\[\];,\\]"/>
  </context>
  <context id="attribute">
    <span token="string" begin='"' end='"' escape="\\." multiLine="true"/>
    <span token="string" begin="'" end="'" escape="\\[\\']" multiLine="true"/>
  </context>
  <context id="interpolation">
    <match token="keyword2" regex="\$[A-Za-z_]\w*(?:-&gt;[A-Za-z_]\w*|\[[^\]]*\])?"/>
    <match token="delimiter" regex="\{(?=\$)|\$\{" push="substitution"/>
  </context>
  <context id="substitution">
    <match token="delimiter" regex="\}" pop="true"/>
    <include context="code"/>
  </context>
</grammar>
