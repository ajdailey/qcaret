<?xml version="1.0" encoding="UTF-8"?>
<!-- QCaret grammar format. A grammar file has no namespace and no DOCTYPE. -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">

  <xs:simpleType name="token">
    <xs:restriction base="xs:string">
      <xs:enumeration value="comment"/>
      <xs:enumeration value="string"/>
      <xs:enumeration value="escape"/>
      <xs:enumeration value="keyword"/>
      <xs:enumeration value="keyword2"/>
      <xs:enumeration value="type"/>
      <xs:enumeration value="number"/>
      <xs:enumeration value="constant"/>
      <xs:enumeration value="operator"/>
      <xs:enumeration value="delimiter"/>
      <xs:enumeration value="function"/>
      <xs:enumeration value="preprocessor"/>
      <xs:enumeration value="tag"/>
      <xs:enumeration value="attribute"/>
      <xs:enumeration value="heading"/>
      <xs:enumeration value="emphasis"/>
      <xs:enumeration value="link"/>
      <xs:enumeration value="invalid"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="id">
    <xs:restriction base="xs:string">
      <xs:pattern value="[a-z0-9][a-z0-9_.+-]{0,63}"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:simpleType name="regex">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
      <xs:maxLength value="4000"/>
    </xs:restriction>
  </xs:simpleType>

  <xs:complexType name="pair">
    <xs:attribute name="open" type="xs:string" use="required"/>
    <xs:attribute name="close" type="xs:string" use="required"/>
  </xs:complexType>

  <xs:complexType name="pairs">
    <xs:sequence>
      <xs:element name="pair" type="pair" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:element name="grammar">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="detect" minOccurs="0">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="extension" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="fileName" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
              <xs:element name="firstLine" type="regex" minOccurs="0"/>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
        <xs:element name="comments" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="line" type="xs:string"/>
            <xs:attribute name="blockStart" type="xs:string"/>
            <xs:attribute name="blockEnd" type="xs:string"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="brackets" type="pairs" minOccurs="0"/>
        <xs:element name="autoClose" type="pairs" minOccurs="0"/>
        <xs:element name="indent" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="increase" type="regex"/>
            <xs:attribute name="decrease" type="regex"/>
            <xs:attribute name="dedentNext" type="regex"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="folding" minOccurs="0">
          <xs:complexType>
            <xs:attribute name="mode" use="required">
              <xs:simpleType>
                <xs:restriction base="xs:string">
                  <xs:enumeration value="none"/>
                  <xs:enumeration value="brackets"/>
                  <xs:enumeration value="markers"/>
                  <xs:enumeration value="indent"/>
                </xs:restriction>
              </xs:simpleType>
            </xs:attribute>
            <xs:attribute name="open" type="xs:string"/>
            <xs:attribute name="close" type="xs:string"/>
            <xs:attribute name="begin" type="regex"/>
            <xs:attribute name="end" type="regex"/>
          </xs:complexType>
        </xs:element>
        <xs:element name="context" maxOccurs="unbounded">
          <xs:complexType>
            <xs:choice minOccurs="0" maxOccurs="unbounded">
              <xs:element name="match">
                <xs:complexType>
                  <xs:attribute name="regex" type="regex" use="required"/>
                  <xs:attribute name="token" type="token"/>
                  <xs:attribute name="push" type="id"/>
                  <xs:attribute name="pop" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="keywords">
                <xs:complexType>
                  <xs:simpleContent>
                    <xs:extension base="xs:string">
                      <xs:attribute name="token" type="token" use="required"/>
                      <xs:attribute name="ignoreCase" type="xs:boolean" default="false"/>
                      <xs:attribute name="wordChars" type="xs:string" default="_"/>
                    </xs:extension>
                  </xs:simpleContent>
                </xs:complexType>
              </xs:element>
              <xs:element name="span">
                <xs:complexType>
                  <xs:attribute name="begin" type="regex" use="required"/>
                  <xs:attribute name="end" type="regex"/>
                  <xs:attribute name="escape" type="regex"/>
                  <xs:attribute name="token" type="token" use="required"/>
                  <xs:attribute name="context" type="id"/>
                  <xs:attribute name="multiLine" type="xs:boolean" default="false"/>
                  <xs:attribute name="nested" type="xs:boolean" default="false"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="include">
                <xs:complexType>
                  <xs:attribute name="context" type="id" use="required"/>
                </xs:complexType>
              </xs:element>
              <xs:element name="embed">
                <xs:complexType>
                  <xs:attribute name="grammar" type="id" use="required"/>
                  <xs:attribute name="begin" type="regex" use="required"/>
                  <xs:attribute name="end" type="regex" use="required"/>
                  <xs:attribute name="token" type="token"/>
                </xs:complexType>
              </xs:element>
            </xs:choice>
            <xs:attribute name="id" type="id" use="required"/>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
      <xs:attribute name="id" type="id" use="required"/>
      <xs:attribute name="name" use="required">
        <xs:simpleType>
          <xs:restriction base="xs:string">
            <xs:minLength value="1"/>
            <xs:maxLength value="64"/>
          </xs:restriction>
        </xs:simpleType>
      </xs:attribute>
      <xs:attribute name="version" type="xs:string" default="1"/>
    </xs:complexType>
    <xs:unique name="contextIds">
      <xs:selector xpath="context"/>
      <xs:field xpath="@id"/>
    </xs:unique>
  </xs:element>
</xs:schema>
