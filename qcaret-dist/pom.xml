<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.github.ajdailey.qcaret</groupId>
        <artifactId>qcaret-parent</artifactId>
        <version>0.1.0</version>
    </parent>

    <artifactId>qcaret-dist</artifactId>
    <packaging>pom</packaging>
    <name>QCaret distribution</name>

    <properties>
        <!-- Final archives. Packaging writes into it and never deletes it. -->
        <qcaret.dist.dir>${maven.multiModuleProjectDirectory}/dist</qcaret.dist.dir>
        <!-- JDK archives and rcodesign, downloaded once and verified by SHA-256;
             override with -Dqcaret.cache.dir. Kept out of ~/.m2 so a CI Maven
             cache does not carry them. -->
        <qcaret.cache.dir>${user.home}/.cache/qcaret-build</qcaret.cache.dir>
        <qcaret.all-targets>false</qcaret.all-targets>
        <!-- qcaret.exe, the zip and the bundles need an x86-64 Linux build
             host; the archive-host profile turns them on. Other hosts build
             and smoke-test qcaret.jar only. -->
        <qcaret.archives>false</qcaret.archives>
        <qcaret.archives.skip>true</qcaret.archives.skip>
    </properties>

    <dependencies>
        <dependency>
            <groupId>io.github.ajdailey.qcaret</groupId>
            <artifactId>qcaret-bootstrap</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ajdailey.qcaret</groupId>
            <artifactId>qcaret-launcher</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.ajdailey.qcaret</groupId>
            <artifactId>qcaret-core</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>parse-version</id>
                        <goals>
                            <goal>parse-version</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <!-- Application jars, without the bootstrap and SWT. -->
                    <execution>
                        <id>stage-lib</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/stage/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                            <excludeGroupIds>org.eclipse.platform</excludeGroupIds>
                            <excludeArtifactIds>qcaret-bootstrap</excludeArtifactIds>
                            <stripVersion>true</stripVersion>
                        </configuration>
                    </execution>
                    <execution>
                        <id>stage-bootstrap</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>unpack</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>io.github.ajdailey.qcaret</groupId>
                                    <artifactId>qcaret-bootstrap</artifactId>
                                    <version>${project.version}</version>
                                    <outputDirectory>${project.build.directory}/stage/bootstrap</outputDirectory>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                    <!-- All six fragments, named by target. -->
                    <execution>
                        <id>stage-swt</id>
                        <phase>prepare-package</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/stage/swt</outputDirectory>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>linux-x86_64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.gtk.linux.aarch64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>linux-aarch64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>windows-x86_64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.win32.win32.aarch64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>windows-aarch64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.cocoa.macosx.x86_64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>macos-x86_64.jar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>org.eclipse.platform</groupId>
                                    <artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
                                    <version>${swt.version}</version>
                                    <destFileName>macos-aarch64.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- qcaret.exe for the universal zip and both Windows bundles. It
                 runs <exe dir>\lib\qcaret.jar with runtime\ when present, else
                 JAVA_HOME, else the PATH. The launch4j header is 32-bit x86
                 and is linked by launch4j's x86-64 Linux tools. -->
            <plugin>
                <groupId>com.akathist.maven.plugins.launch4j</groupId>
                <artifactId>launch4j-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>qcaret-exe</id>
                        <phase>package</phase>
                        <goals>
                            <goal>launch4j</goal>
                        </goals>
                        <configuration>
                            <skip>${qcaret.archives.skip}</skip>
                            <headerType>gui</headerType>
                            <outfile>${project.build.directory}/qcaret.exe</outfile>
                            <dontWrapJar>true</dontWrapJar>
                            <jar>lib\qcaret.jar</jar>
                            <errTitle>QCaret</errTitle>
                            <icon>${project.basedir}/src/icons/qcaret.ico</icon>
                            <jre>
                                <path>runtime;%JAVA_HOME%;%PATH%</path>
                                <minVersion>21.0.0</minVersion>
                                <requires64Bit>true</requires64Bit>
                                <opts>
                                    <opt>-XX:MaxRAMPercentage=50</opt>
                                </opts>
                            </jre>
                            <!-- Explicit file properties; the defaults would
                                 fill company and copyright with placeholders.
                                 fileVersion and productVersion must have four
                                 numbers. -->
                            <disableVersionInfoDefaults>true</disableVersionInfoDefaults>
                            <versionInfo>
                                <fileVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.0</fileVersion>
                                <productVersion>${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.0</productVersion>
                                <txtFileVersion>${project.version}</txtFileVersion>
                                <txtProductVersion>${project.version}</txtProductVersion>
                                <fileDescription>QCaret text editor</fileDescription>
                                <productName>QCaret</productName>
                                <companyName>QCaret</companyName>
                                <copyright>Copyright 2026 Adam Dailey</copyright>
                                <internalName>qcaret</internalName>
                                <originalFilename>qcaret.exe</originalFilename>
                            </versionInfo>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>assemble</id>
                        <phase>package</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <property name="qcaret.root" value="${maven.multiModuleProjectDirectory}"/>
                                <ant antfile="${project.basedir}/src/build/dist.xml" inheritAll="true"/>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!-- Smoke tests against the built jar and the host bundle. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <executions>
                    <execution>
                        <id>smoke-compile</id>
                        <phase>pre-integration-test</phase>
                        <goals>
                            <goal>testCompile</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <executions>
                    <execution>
                        <id>smoke</id>
                        <phase>integration-test</phase>
                        <goals>
                            <goal>test</goal>
                        </goals>
                        <configuration>
                            <systemPropertyVariables>
                                <qcaret.jar>${project.build.directory}/qcaret.jar</qcaret.jar>
                                <qcaret.version>${project.version}</qcaret.version>
                                <qcaret.dist.dir>${qcaret.dist.dir}</qcaret.dist.dir>
                                <qcaret.target.name>${qcaret.target.name}</qcaret.target.name>
                            </systemPropertyVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- qcaret.jar ships all six fragments; the SBOM lists them through
             these dependencies. stage-lib excludes org.eclipse.platform, so
             they leave the archives unchanged. -->
        <profile>
            <id>sbom</id>
            <dependencies>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.gtk.linux.x86_64</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.gtk.linux.aarch64</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.win32.win32.x86_64</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.win32.win32.aarch64</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.cocoa.macosx.x86_64</artifactId>
                    <scope>runtime</scope>
                </dependency>
                <dependency>
                    <groupId>org.eclipse.platform</groupId>
                    <artifactId>org.eclipse.swt.cocoa.macosx.aarch64</artifactId>
                    <scope>runtime</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>archive-host</id>
            <activation>
                <os>
                    <name>Linux</name>
                    <arch>amd64</arch>
                </os>
            </activation>
            <properties>
                <qcaret.archives>true</qcaret.archives>
                <qcaret.archives.skip>false</qcaret.archives.skip>
            </properties>
        </profile>
        <profile>
            <id>all-targets</id>
            <properties>
                <qcaret.all-targets>true</qcaret.all-targets>
            </properties>
        </profile>
    </profiles>
</project>
