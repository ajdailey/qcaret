<?xml version="1.0" encoding="UTF-8"?>
<!-- Assembles the universal jar and zip and the per-target bundles. Run by
     maven-antrun-plugin from qcaret-dist/pom.xml, which supplies the staged
     jars and every property used here. The archives need a Linux x86_64 build
     host (tar, jlink, jmod, rcodesign); with qcaret.archives false only
     qcaret.jar is built. -->
<project name="qcaret-dist" default="all" xmlns:if="ant:if" xmlns:unless="ant:unless"
    xmlns:rcmp="antlib:org.apache.tools.ant.types.resources.comparators">

  <property name="build" location="${project.build.directory}"/>
  <property name="stage" location="${build}/stage"/>
  <property name="jar.root" location="${build}/jar-root"/>
  <property name="universal.jar" location="${build}/qcaret.jar"/>
  <property name="out" location="${qcaret.dist.dir}"/>
  <!-- Temurin JDK archives, from jdk.url unless jdk.<target>.url names
       another release. Adoptium publishes no windows-aarch64 build of
       21.0.13.1+2, so that target takes 21.0.12.1+1. -->
  <property name="jdk.url"
      value="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.13.1%2B2"/>
  <property name="jdk.linux-x86_64" value="OpenJDK21U-jdk_x64_linux_hotspot_21.0.13.1_2.tar.gz"/>
  <property name="jdk.linux-x86_64.sha256" value="bb8a93f9ae6e7a693b2b721e85dbeff26ae1a77447985a8d7afcdd9c7cf6222e"/>
  <property name="jdk.linux-aarch64" value="OpenJDK21U-jdk_aarch64_linux_hotspot_21.0.13.1_2.tar.gz"/>
  <property name="jdk.linux-aarch64.sha256" value="8c72816a6b308842d5ed1f13e5826b69c567da4784f7238d7e800efa71fe54b1"/>
  <property name="jdk.windows-x86_64" value="OpenJDK21U-jdk_x64_windows_hotspot_21.0.13.1_2.zip"/>
  <property name="jdk.windows-x86_64.sha256" value="bbebea1469996b276683c9299c227b294f85c847039c82633218186a4ad4fbf2"/>
  <property name="jdk.windows-aarch64.url"
      value="https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.12.1%2B1"/>
  <property name="jdk.windows-aarch64" value="OpenJDK21U-jdk_aarch64_windows_hotspot_21.0.12.1_1.zip"/>
  <property name="jdk.windows-aarch64.sha256" value="ccf2e51f527d542a70ba5794a600d3aac04b4e967950e227834c7566cb1bec7b"/>
  <property name="jdk.macos-x86_64" value="OpenJDK21U-jdk_x64_mac_hotspot_21.0.13.1_2.tar.gz"/>
  <property name="jdk.macos-x86_64.sha256" value="1b5eff1741bb83d32e2e19aade71452bb42e40f047c01d3e178d438304c9a26d"/>
  <property name="jdk.macos-aarch64" value="OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.13.1_2.tar.gz"/>
  <property name="jdk.macos-aarch64.sha256" value="48067f2b7c958ed104a9d8a5749be7d25220b0a356b4d2d1bcfaab3e16ad0b14"/>
  <property name="rcodesign.archive" value="apple-codesign-0.29.0-x86_64-unknown-linux-musl.tar.gz"/>
  <property name="rcodesign.sha256" value="dbe85cedd8ee4217b64e9a0e4c2aef92ab8bcaaa41f20bde99781ff02e600002"/>
  <property name="rcodesign.url"
      value="https://github.com/indygreg/apple-platform-rs/releases/download/apple-codesign%2F0.29.0"/>
  <!-- nfpm writes the .deb and .rpm; makensis, from Ubuntu 24.04's nsis and
       nsis-common packages, the Windows installers. -->
  <property name="nfpm.archive" value="nfpm_2.48.0_Linux_x86_64.tar.gz"/>
  <property name="nfpm.sha256" value="6d7f9a28b2f397934403950fcbba83f598b08d02edbe79a0815b3b4897341750"/>
  <property name="nfpm.url" value="https://github.com/goreleaser/nfpm/releases/download/v2.48.0"/>
  <property name="nsis.url" value="http://archive.ubuntu.com/ubuntu/pool/universe/n/nsis"/>
  <property name="nsis.deb" value="nsis_3.09-4ubuntu1_amd64.deb"/>
  <property name="nsis.deb.sha256" value="9e061bef1a8b611aeb2ea76d9a3bd7722b960ca1a9dff8e38d2ab51e5a8f5e5b"/>
  <property name="nsis-common.deb" value="nsis-common_3.09-4ubuntu1_all.deb"/>
  <property name="nsis-common.deb.sha256" value="49471b9debdee4751ebb4caf6b705cc4c678eebfaecefbe56362258893f85859"/>
  <property name="pkg.arch.linux-x86_64" value="amd64"/>
  <property name="pkg.arch.linux-aarch64" value="arm64"/>
  <!-- jdeps over the application jars reports java.desktop (SWT_AWT only,
       unused), java.logging, java.naming and java.xml; jdk.zipfs serves the bootstrap's
       nested-jar loader; jdk.charsets holds the legacy encodings (Big5, EUC-JP,
       EUC-KR, GBK, Shift_JIS, windows-31j and more) that java.base lacks on
       Windows and macOS; jdk.localedata holds the date and number formats of
       every locale but English; java.management serves the memory
       indicator's heap pool reads. -->
  <property name="modules"
      value="java.base,java.logging,java.management,java.naming,java.xml,jdk.charsets,jdk.localedata,jdk.unsupported,jdk.zipfs"/>

  <!-- Every jar and zip entry carries project.build.outputTimestamp. Ant
       writes zip entry times in the host time zone, so archive.time is that
       instant's UTC wall time in a local-time pattern: each host then writes
       the UTC fields, as maven-jar-plugin does. -->
  <property name="ant.tstamp.now.iso" value="${project.build.outputTimestamp}"/>
  <tstamp>
    <format property="archive.time" pattern="MM/dd/yyyy hh:mm:ss a" locale="en,US" timezone="UTC"/>
  </tstamp>

  <!-- Downloads a file into the cache once and verifies its SHA-256. -->
  <macrodef name="fetch">
    <attribute name="url"/>
    <attribute name="name"/>
    <attribute name="sha256"/>
    <sequential>
      <mkdir dir="${qcaret.cache.dir}"/>
      <local name="cached"/>
      <available file="${qcaret.cache.dir}/@{name}" property="cached"/>
      <get unless:set="cached" src="@{url}/@{name}" dest="${qcaret.cache.dir}/@{name}.part"/>
      <move unless:set="cached" file="${qcaret.cache.dir}/@{name}.part"
          tofile="${qcaret.cache.dir}/@{name}"/>
      <local name="verified"/>
      <checksum file="${qcaret.cache.dir}/@{name}" algorithm="SHA-256"
          property="@{sha256}" verifyproperty="verified"/>
      <fail message="${qcaret.cache.dir}/@{name} does not match its SHA-256; delete it to download again.">
        <condition><isfalse value="${verified}"/></condition>
      </fail>
    </sequential>
  </macrodef>

  <target name="all" depends="universal,exe,universal-zip,bundles"/>

  <!-- qcaret.jar: the bootstrap at the root, the application jars and all six
       SWT fragments nested unmodified, the SHA-256 of every native, and
       LICENSE, NOTICE and THIRD-PARTY.txt in META-INF/. -->
  <target name="universal">
    <delete dir="${jar.root}"/>
    <copy todir="${jar.root}">
      <fileset dir="${stage}/bootstrap" excludes="META-INF/MANIFEST.MF,META-INF/maven/**"/>
    </copy>
    <copy todir="${jar.root}/META-INF"><fileset refid="notices"/></copy>
    <copy file="${basedir}/src/dist/THIRD-PARTY.txt" todir="${jar.root}/META-INF"/>
    <copy todir="${jar.root}/META-INF/qcaret/lib">
      <fileset dir="${stage}/lib" includes="*.jar"/>
    </copy>
    <copy todir="${jar.root}/META-INF/qcaret/swt">
      <fileset dir="${stage}/swt" includes="*.jar"/>
    </copy>
    <natives target="linux-x86_64"/>
    <natives target="linux-aarch64"/>
    <natives target="windows-x86_64"/>
    <natives target="windows-aarch64"/>
    <natives target="macos-x86_64"/>
    <natives target="macos-aarch64"/>
    <pathconvert property="libs" pathsep=",">
      <sort><fileset dir="${stage}/lib" includes="*.jar"/></sort>
      <flattenmapper/>
    </pathconvert>
    <echo file="${jar.root}/META-INF/qcaret/index.properties" encoding="UTF-8">swt.version=${swt.version}
lib=${libs}
natives.linux-x86_64=${natives.linux-x86_64}
natives.linux-aarch64=${natives.linux-aarch64}
natives.windows-x86_64=${natives.windows-x86_64}
natives.windows-aarch64=${natives.windows-aarch64}
natives.macos-x86_64=${natives.macos-x86_64}
natives.macos-aarch64=${natives.macos-aarch64}
</echo>
    <jar destfile="${universal.jar}" basedir="${jar.root}"
        modificationtime="${archive.time}">
      <manifest>
        <attribute name="Main-Class" value="io.github.ajdailey.qcaret.bootstrap.Main"/>
        <attribute name="Implementation-Title" value="QCaret"/>
        <attribute name="Implementation-Version" value="${project.version}"/>
      </manifest>
    </jar>
  </target>

  <target name="archives">
    <condition property="archives">
      <istrue value="${qcaret.archives}"/>
    </condition>
  </target>

  <!-- launch4j's ld stamps qcaret.exe with the link time and runs inside
       Maven, where SOURCE_DATE_EPOCH cannot be set; PeTimestamp writes the
       build instant and checksum that ld writes with it set. -->
  <target name="exe" depends="archives" if="archives">
    <exec executable="${java.home}/bin/java" failonerror="true">
      <arg file="${basedir}/src/build/PeTimestamp.java"/>
      <arg file="${build}/qcaret.exe"/>
      <arg value="${project.build.outputTimestamp}"/>
    </exec>
  </target>

  <target name="universal-zip" depends="archives" if="archives">
    <mkdir dir="${out}"/>
    <zip destfile="${out}/qcaret-${project.version}.zip"
        modificationtime="${archive.time}">
      <zipfileset file="${basedir}/src/bin/qcaret" fullpath="qcaret/bin/qcaret" filemode="755"/>
      <zipfileset file="${basedir}/src/linux/install-desktop-entry"
          fullpath="qcaret/bin/install-desktop-entry" filemode="755"/>
      <zipfileset file="${basedir}/src/linux/qcaret.desktop" fullpath="qcaret/share/qcaret.desktop"/>
      <zipfileset file="${basedir}/src/icons/qcaret.svg" fullpath="qcaret/share/qcaret.svg"/>
      <zipfileset file="${universal.jar}" fullpath="qcaret/lib/qcaret.jar"/>
      <zipfileset file="${build}/qcaret.exe" fullpath="qcaret/qcaret.exe"/>
      <zipfileset file="${basedir}/src/windows/qcaret.cmd" fullpath="qcaret/qcaret.cmd"/>
      <zipfileset file="${basedir}/src/windows/register-associations.cmd"
          fullpath="qcaret/register-associations.cmd"/>
      <zipfileset refid="notices" prefix="qcaret"/>
      <zipfileset file="${basedir}/src/dist/THIRD-PARTY.txt" fullpath="qcaret/THIRD-PARTY.txt"/>
    </zip>
  </target>

  <fileset id="notices" dir="${qcaret.root}" includes="LICENSE,NOTICE"/>

  <!-- Extracts one target's natives from its fragment and writes their
       digests; sets natives.<target> to the comma-separated names. checksum
       writes the host's line separator and a file sorts by the host's path
       order (case-insensitive on Windows), so both are fixed here. -->
  <macrodef name="natives">
    <attribute name="target"/>
    <sequential>
      <delete dir="${build}/natives/@{target}"/>
      <unzip src="${stage}/swt/@{target}.jar" dest="${build}/natives/@{target}">
        <patternset includes="*.so,*.dll,*.jnilib"/>
      </unzip>
      <checksum algorithm="SHA-256" fileext=".sha256"
          todir="${jar.root}/META-INF/qcaret/natives/@{target}">
        <fileset dir="${build}/natives/@{target}"/>
      </checksum>
      <fixcrlf srcdir="${jar.root}/META-INF/qcaret/natives/@{target}" includes="*.sha256" eol="lf"/>
      <pathconvert property="natives.@{target}" pathsep=",">
        <sort>
          <rcmp:name/>
          <fileset dir="${build}/natives/@{target}"/>
        </sort>
        <flattenmapper/>
      </pathconvert>
    </sequential>
  </macrodef>

  <target name="bundles" depends="archives" if="archives">
    <condition property="bundle.linux-x86_64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="linux-x86_64"/></or>
    </condition>
    <condition property="bundle.linux-aarch64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="linux-aarch64"/></or>
    </condition>
    <condition property="bundle.windows-x86_64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="windows-x86_64"/></or>
    </condition>
    <condition property="bundle.windows-aarch64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="windows-aarch64"/></or>
    </condition>
    <condition property="bundle.macos-x86_64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="macos-x86_64"/></or>
    </condition>
    <condition property="bundle.macos-aarch64">
      <or><istrue value="${qcaret.all-targets}"/><equals arg1="${qcaret.target.name}" arg2="macos-aarch64"/></or>
    </condition>
    <posix-bundle if:set="bundle.linux-x86_64" target="linux-x86_64"/>
    <posix-bundle if:set="bundle.linux-aarch64" target="linux-aarch64"/>
    <windows-bundle if:set="bundle.windows-x86_64" target="windows-x86_64"/>
    <windows-bundle if:set="bundle.windows-aarch64" target="windows-aarch64"/>
    <macos-bundle if:set="bundle.macos-x86_64" target="macos-x86_64"/>
    <macos-bundle if:set="bundle.macos-aarch64" target="macos-aarch64"/>
  </target>

  <!-- Fetches a target's JDK and extracts its jmods to ${build}/jdk/<target>,
       without the archive's top directory. -->
  <macrodef name="jmods">
    <attribute name="target"/>
    <attribute name="zip" default="false"/>
    <sequential>
      <local name="url"/>
      <condition property="url" value="${jdk.@{target}.url}" else="${jdk.url}">
        <isset property="jdk.@{target}.url"/>
      </condition>
      <fetch url="${url}" name="${jdk.@{target}}" sha256="${jdk.@{target}.sha256}"/>
      <delete dir="${build}/jdk/@{target}"/>
      <mkdir dir="${build}/jdk/@{target}"/>
      <unzip if:true="@{zip}" src="${qcaret.cache.dir}/${jdk.@{target}}" dest="${build}/jdk/@{target}">
        <patternset includes="*/jmods/**"/>
        <cutdirsmapper dirs="1"/>
      </unzip>
      <exec unless:true="@{zip}" executable="tar" failonerror="true">
        <arg value="-xzf"/>
        <arg file="${qcaret.cache.dir}/${jdk.@{target}}"/>
        <arg value="-C"/>
        <arg file="${build}/jdk/@{target}"/>
        <arg value="--strip-components=1"/>
        <arg value="--wildcards"/>
        <arg value="*/jmods/*"/>
      </exec>
    </sequential>
  </macrodef>

  <!-- Links a runtime image for a target from its jmods with the build JDK's
       jlink. Debug symbols are kept: strip-debug runs the host objcopy on
       target binaries and fails across targets. -->
  <macrodef name="runtime">
    <attribute name="jmods"/>
    <attribute name="output"/>
    <sequential>
      <delete dir="@{output}"/>
      <!-- jlink writes a different lib/modules under a non-UTF-8 locale, and
           under a different CDS archive: whether the classes it generates
           carry SourceFile follows the build JDK's classes.jsa. -->
      <exec executable="${java.home}/bin/jlink" failonerror="true">
        <env key="LC_ALL" value="C.UTF-8"/>
        <arg value="-J-Xshare:off"/>
        <arg value="--module-path"/>
        <arg file="@{jmods}"/>
        <arg value="--add-modules"/>
        <arg value="${modules}"/>
        <arg value="--strip-java-debug-attributes"/>
        <arg value="--no-header-files"/>
        <arg value="--no-man-pages"/>
        <arg value="--output"/>
        <arg file="@{output}"/>
      </exec>
      <!-- jlink on a POSIX host makes legal/<module>/ notices links into
           legal/java.base/. Copies keep the notices for an extractor that
           drops links, and make the macOS seal match what unzips. -->
      <copy todir="@{output}/legal.files">
        <fileset dir="@{output}/legal"/>
      </copy>
      <delete dir="@{output}/legal"/>
      <move file="@{output}/legal.files" tofile="@{output}/legal"/>
      <!-- java.base's keytool launcher; QCaret never runs it. -->
      <delete>
        <fileset dir="@{output}/bin" includes="keytool,keytool.exe"/>
      </delete>
    </sequential>
  </macrodef>

  <!-- Unzips a target's SWT natives and notices into a lib/swt directory. -->
  <macrodef name="swt-dir">
    <attribute name="target"/>
    <attribute name="dest"/>
    <sequential>
      <unzip src="${stage}/swt/@{target}.jar" dest="@{dest}">
        <patternset includes="*.so,*.dll,*.jnilib,about.html,about_files/**"/>
      </unzip>
    </sequential>
  </macrodef>

  <!-- Unzips a target's SWT notices, without its natives. -->
  <macrodef name="swt-notices">
    <attribute name="target"/>
    <attribute name="dest"/>
    <sequential>
      <unzip src="${stage}/swt/@{target}.jar" dest="@{dest}">
        <patternset includes="about.html,about_files/**"/>
      </unzip>
    </sequential>
  </macrodef>

  <macrodef name="posix-bundle">
    <attribute name="target"/>
    <sequential>
      <jmods target="@{target}"/>
      <local name="home"/>
      <property name="home" location="${build}/bundles/@{target}/qcaret"/>
      <delete dir="${build}/bundles/@{target}"/>
      <runtime jmods="${build}/jdk/@{target}/jmods" output="${home}/runtime"/>
      <copy file="${universal.jar}" todir="${home}/lib"/>
      <swt-dir target="@{target}" dest="${home}/lib/swt"/>
      <copy file="${basedir}/src/bin/qcaret" todir="${home}/bin"/>
      <copy file="${basedir}/src/linux/install-desktop-entry" todir="${home}/bin"/>
      <copy file="${basedir}/src/linux/qcaret.desktop" todir="${home}/share"/>
      <copy file="${basedir}/src/icons/qcaret.svg" todir="${home}/share"/>
      <copy todir="${home}"><fileset refid="notices"/></copy>
      <copy file="${basedir}/src/dist/THIRD-PARTY.txt" todir="${home}"/>
      <!-- The marker goes in the archive only, not in the packages. -->
      <copy file="${basedir}/src/dist/portable.txt" todir="${home}"/>
      <mkdir dir="${out}"/>
      <!-- Ant's tar has no modificationtime and dates each entry from its
           file, so GNU tar writes the archive: entries sorted by name, one
           mtime, root owner, and modes set here rather than by the umask. -->
      <chmod perm="755" type="dir"><dirset dir="${build}/bundles/@{target}"/></chmod>
      <chmod perm="644" type="file"><fileset dir="${build}/bundles/@{target}"/></chmod>
      <chmod perm="755" type="file">
        <fileset dir="${build}/bundles/@{target}"
            includes="qcaret/bin/*,qcaret/runtime/bin/*,qcaret/runtime/lib/jspawnhelper"/>
      </chmod>
      <exec executable="tar" failonerror="true">
        <env key="LC_ALL" value="C"/>
        <arg value="--sort=name"/>
        <arg value="--mtime=${project.build.outputTimestamp}"/>
        <arg value="--owner=0"/>
        <arg value="--group=0"/>
        <arg value="--numeric-owner"/>
        <arg value="--format=gnu"/>
        <arg value="-cf"/>
        <arg file="${build}/bundles/@{target}.tar"/>
        <arg value="-C"/>
        <arg file="${build}/bundles/@{target}"/>
        <arg value="qcaret"/>
      </exec>
      <gzip src="${build}/bundles/@{target}.tar" destfile="${out}/qcaret-${project.version}-@{target}-portable.tar.gz"/>
      <delete file="${home}/portable.txt"/>
      <linux-packages target="@{target}"/>
    </sequential>
  </macrodef>

  <macrodef name="windows-bundle">
    <attribute name="target"/>
    <sequential>
      <jmods target="@{target}" zip="true"/>
      <local name="home"/>
      <property name="home" location="${build}/bundles/@{target}/qcaret"/>
      <delete dir="${build}/bundles/@{target}"/>
      <runtime jmods="${build}/jdk/@{target}/jmods" output="${home}/runtime"/>
      <!-- Windows 10 and later load the system UCRT, never an app-local copy. -->
      <delete>
        <fileset dir="${home}/runtime/bin" includes="ucrtbase.dll,api-ms-win-*.dll"/>
      </delete>
      <copy file="${universal.jar}" todir="${home}/lib"/>
      <swt-dir target="@{target}" dest="${home}/lib/swt"/>
      <copy file="${build}/qcaret.exe" todir="${home}"/>
      <copy file="${basedir}/src/windows/qcaret.cmd" todir="${home}"/>
      <copy file="${basedir}/src/windows/register-associations.cmd" todir="${home}"/>
      <copy todir="${home}"><fileset refid="notices"/></copy>
      <copy file="${basedir}/src/dist/THIRD-PARTY.txt" todir="${home}"/>
      <mkdir dir="${out}"/>
      <!-- The marker sits outside the bundle tree, which the installer lists
           whole; the zip adds it and the portable choice writes it. -->
      <copy file="${basedir}/src/dist/portable.txt" todir="${build}/windows" overwrite="true">
        <filterchain><fixcrlf eol="crlf"/></filterchain>
      </copy>
      <zip destfile="${out}/qcaret-${project.version}-@{target}-portable.zip"
          modificationtime="${archive.time}">
        <zipfileset dir="${build}/bundles/@{target}"/>
        <zipfileset file="${build}/windows/portable.txt" prefix="qcaret"/>
      </zip>
      <windows-installer target="@{target}"/>
    </sequential>
  </macrodef>

  <!-- Renders the hicolor icons and the NSIS bitmaps from qcaret.svg into
       ${build}/installer/art, once per build. -->
  <macrodef name="installer-art">
    <sequential>
      <exec unless:set="installer.art.done" executable="${java.home}/bin/java" failonerror="true">
        <arg value="-Djava.awt.headless=true"/>
        <arg value="-cp"/>
        <arg file="${build}/installer-tools/jsvg.jar"/>
        <arg file="${basedir}/src/build/InstallerArt.java"/>
        <arg file="${basedir}/src/icons/qcaret.svg"/>
        <arg file="${build}/installer/art"/>
      </exec>
      <property name="installer.art.done" value="true"/>
    </sequential>
  </macrodef>

  <!-- Dates every file and directory under dir, links included,
       project.build.outputTimestamp: nfpm and makensis store each file's
       time. -->
  <macrodef name="date-tree">
    <attribute name="dir"/>
    <sequential>
      <exec executable="find" failonerror="true">
        <arg file="@{dir}"/>
        <arg value="-exec"/>
        <arg value="touch"/>
        <arg value="-h"/>
        <arg value="--date=${project.build.outputTimestamp}"/>
        <arg value="{}"/>
        <arg value="+"/>
      </exec>
    </sequential>
  </macrodef>

  <!-- The .deb and .rpm of a Linux target from its bundle tree, which
       posix-bundle has already given fixed modes: /opt/qcaret, /usr/bin/qcaret,
       the desktop entry with Exec /opt/qcaret/bin/qcaret, and the hicolor icons. The package version is the
       project version with - as ~, so 0.2.0-rc1 sorts before 0.2.0. -->
  <macrodef name="linux-packages">
    <attribute name="target"/>
    <sequential>
      <installer-art/>
      <fetch url="${nfpm.url}" name="${nfpm.archive}" sha256="${nfpm.sha256}"/>
      <mkdir dir="${build}/tools/nfpm"/>
      <exec executable="tar" failonerror="true">
        <arg value="-xzf"/>
        <arg file="${qcaret.cache.dir}/${nfpm.archive}"/>
        <arg value="-C"/>
        <arg file="${build}/tools/nfpm"/>
        <arg value="nfpm"/>
      </exec>
      <date-tree dir="${build}/bundles/@{target}/qcaret"/>
      <local name="pkg.version"/>
      <loadresource property="pkg.version">
        <propertyresource name="project.version"/>
        <filterchain><tokenfilter><replacestring from="-" to="~"/></tokenfilter></filterchain>
      </loadresource>
      <local name="config"/>
      <property name="config" location="${build}/packages/@{target}/nfpm.yaml"/>
      <copy file="${basedir}/src/linux/nfpm.yaml" tofile="${config}" overwrite="true">
        <filterchain>
          <replacetokens>
            <token key="ARCH" value="${pkg.arch.@{target}}"/>
            <token key="VERSION" value="${pkg.version}"/>
            <token key="MTIME" value="${project.build.outputTimestamp}"/>
            <token key="HOME" value="${build}/bundles/@{target}/qcaret"/>
            <token key="SRC" value="${build}/packages/@{target}"/>
            <token key="ICONS" value="${basedir}/src/icons"/>
            <token key="ART" value="${build}/installer/art"/>
          </replacetokens>
        </filterchain>
      </copy>
      <copy file="${basedir}/src/linux/qcaret.desktop" todir="${build}/packages/@{target}"
          overwrite="true">
        <filterchain>
          <replacetokens><token key="EXEC" value="/opt/qcaret/bin/qcaret"/></replacetokens>
        </filterchain>
      </copy>
      <date-tree dir="${build}/packages/@{target}"/>
      <exec executable="${build}/tools/nfpm/nfpm" failonerror="true">
        <arg value="package"/>
        <arg value="--config"/>
        <arg file="${config}"/>
        <arg value="--packager"/>
        <arg value="deb"/>
        <arg value="--target"/>
        <arg file="${out}/qcaret-${project.version}-@{target}.deb"/>
      </exec>
      <exec executable="${build}/tools/nfpm/nfpm" failonerror="true">
        <arg value="package"/>
        <arg value="--config"/>
        <arg file="${config}"/>
        <arg value="--packager"/>
        <arg value="rpm"/>
        <arg value="--target"/>
        <arg file="${out}/qcaret-${project.version}-@{target}.rpm"/>
      </exec>
    </sequential>
  </macrodef>

  <!-- qcaret-<version>-<target>-setup.exe from the Windows bundle tree, its
       files listed by NsisFiles in name order. A signed qcaret.exe goes into
       the tree before this macro. -->
  <macrodef name="windows-installer">
    <attribute name="target"/>
    <sequential>
      <installer-art/>
      <fetch url="${nsis.url}" name="${nsis.deb}" sha256="${nsis.deb.sha256}"/>
      <fetch url="${nsis.url}" name="${nsis-common.deb}" sha256="${nsis-common.deb.sha256}"/>
      <local name="nsis"/>
      <property name="nsis" location="${build}/tools/nsis"/>
      <delete dir="${nsis}"/>
      <mkdir dir="${nsis}"/>
      <exec executable="dpkg-deb" failonerror="true">
        <arg value="-x"/>
        <arg file="${qcaret.cache.dir}/${nsis.deb}"/>
        <arg file="${nsis}"/>
      </exec>
      <exec executable="dpkg-deb" failonerror="true">
        <arg value="-x"/>
        <arg file="${qcaret.cache.dir}/${nsis-common.deb}"/>
        <arg file="${nsis}"/>
      </exec>
      <local name="work"/>
      <property name="work" location="${build}/installer/@{target}"/>
      <delete dir="${work}"/>
      <mkdir dir="${work}"/>
      <copy file="${qcaret.root}/LICENSE" tofile="${work}/LICENSE.txt">
        <filterchain><fixcrlf eol="crlf"/></filterchain>
      </copy>
      <!-- MUI2 stores the bitmaps with File too, and setup the marker. -->
      <date-tree dir="${build}/installer"/>
      <date-tree dir="${build}/windows"/>
      <date-tree dir="${build}/bundles/@{target}/qcaret"/>
      <exec executable="${java.home}/bin/java" failonerror="true">
        <arg file="${basedir}/src/build/NsisFiles.java"/>
        <arg file="${build}/bundles/@{target}/qcaret"/>
        <arg file="${work}/files.nsh"/>
      </exec>
      <exec executable="${nsis}/usr/bin/makensis" failonerror="true">
        <env key="NSISDIR" file="${nsis}/usr/share/nsis"/>
        <env key="LC_ALL" value="C.UTF-8"/>
        <arg value="-NOCONFIG"/>
        <arg value="-V2"/>
        <arg value="-INPUTCHARSET"/>
        <arg value="UTF8"/>
        <arg value="-DVERSION=${project.version}"/>
        <arg value="-DVI_VERSION=${parsedVersion.majorVersion}.${parsedVersion.minorVersion}.${parsedVersion.incrementalVersion}.0"/>
        <arg value="-DFILES=${work}/files.nsh"/>
        <arg value="-DART=${build}/installer/art/nsis"/>
        <arg value="-DICON=${basedir}/src/icons/qcaret.ico"/>
        <arg value="-DLICENSE=${work}/LICENSE.txt"/>
        <arg value="-DPORTABLE=${build}/windows/portable.txt"/>
        <arg value="-DOUTFILE=${out}/qcaret-${project.version}-@{target}-setup.exe"/>
        <arg file="${basedir}/src/windows/qcaret.nsi"/>
      </exec>
    </sequential>
  </macrodef>

  <!-- QCaret.app: the jpackage launcher from the target JDK's jdk.jpackage
       module reads Contents/app/QCaret.cfg and runs Contents/runtime. The
       bundle is ad-hoc signed with rcodesign. It carries no lib/swt: signing
       would rewrite the jnilibs and break their digests, so the bootstrap
       extracts them from the jar into the user cache. -->
  <macrodef name="macos-bundle">
    <attribute name="target"/>
    <sequential>
      <jmods target="@{target}"/>
      <local name="jmods"/>
      <property name="jmods" location="${build}/jdk/@{target}/Contents/Home/jmods"/>
      <local name="app"/>
      <property name="app" location="${build}/bundles/@{target}/QCaret.app"/>
      <local name="contents"/>
      <property name="contents" location="${app}/Contents"/>
      <delete dir="${build}/bundles/@{target}"/>

      <runtime jmods="${jmods}" output="${contents}/runtime/Contents/Home"/>
      <copy file="${contents}/runtime/Contents/Home/lib/libjli.dylib"
          todir="${contents}/runtime/Contents/MacOS"/>

      <delete dir="${build}/jpackage/@{target}"/>
      <exec executable="${java.home}/bin/jmod" failonerror="true">
        <arg value="extract"/>
        <arg value="--dir"/>
        <arg file="${build}/jpackage/@{target}"/>
        <arg file="${jmods}/jdk.jpackage.jmod"/>
      </exec>
      <local name="resources"/>
      <property name="resources"
          location="${build}/jpackage/@{target}/classes/jdk/jpackage/internal/resources"/>
      <copy file="${resources}/jpackageapplauncher" tofile="${contents}/MacOS/QCaret"/>
      <copy file="${resources}/Runtime-Info.plist.template"
          tofile="${contents}/runtime/Contents/Info.plist">
        <filterchain>
          <replacestring from="CF_BUNDLE_IDENTIFIER" to="io.github.ajdailey.qcaret"/>
          <replacestring from="CF_BUNDLE_NAME" to="QCaret"/>
          <replacestring from="CF_BUNDLE_SHORT_VERSION_STRING" to="${project.version}"/>
          <replacestring from="CF_BUNDLE_VERSION" to="${project.version}"/>
        </filterchain>
      </copy>
      <copy file="${basedir}/src/macos/Info.plist" todir="${contents}">
        <filterchain><replacestring from="@VERSION@" to="${project.version}"/></filterchain>
      </copy>
      <copy file="${basedir}/src/macos/QCaret.cfg" todir="${contents}/app"/>
      <copy file="${universal.jar}" todir="${contents}/app/lib"/>
      <swt-notices target="@{target}" dest="${contents}/Resources/swt"/>
      <copy file="${basedir}/src/icons/QCaret.icns" todir="${contents}/Resources"/>
      <copy todir="${contents}/Resources"><fileset refid="notices"/></copy>
      <copy file="${basedir}/src/dist/THIRD-PARTY.txt" todir="${contents}/Resources"/>
      <chmod perm="755" type="file">
        <fileset dir="${contents}" includes="MacOS/QCaret,runtime/Contents/Home/bin/*,runtime/Contents/Home/lib/jspawnhelper"/>
      </chmod>

      <fetch url="${rcodesign.url}" name="${rcodesign.archive}" sha256="${rcodesign.sha256}"/>
      <local name="rcodesign"/>
      <property name="rcodesign"
          location="${build}/tools/apple-codesign-0.29.0-x86_64-unknown-linux-musl/rcodesign"/>
      <mkdir dir="${build}/tools"/>
      <exec executable="tar" failonerror="true">
        <arg value="-xzf"/>
        <arg file="${qcaret.cache.dir}/${rcodesign.archive}"/>
        <arg value="-C"/>
        <arg file="${build}/tools"/>
      </exec>
      <exec executable="${rcodesign}" failonerror="true">
        <arg value="sign"/>
        <arg value="--entitlements-xml-file"/>
        <arg file="${basedir}/src/macos/qcaret.entitlements"/>
        <arg file="${app}"/>
      </exec>

      <mkdir dir="${out}"/>
      <zip destfile="${out}/qcaret-${project.version}-@{target}.zip"
          modificationtime="${archive.time}">
        <zipfileset dir="${build}/bundles/@{target}" filemode="755"
            includes="QCaret.app/Contents/MacOS/QCaret,QCaret.app/Contents/runtime/Contents/Home/bin/*,QCaret.app/Contents/runtime/Contents/Home/lib/jspawnhelper"/>
        <zipfileset dir="${build}/bundles/@{target}"
            excludes="QCaret.app/Contents/MacOS/QCaret,QCaret.app/Contents/runtime/Contents/Home/bin/*,QCaret.app/Contents/runtime/Contents/Home/lib/jspawnhelper"/>
      </zip>
    </sequential>
  </macrodef>
</project>
