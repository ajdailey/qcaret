<?xml version="1.0" encoding="UTF-8"?>
<!-- Each suppression names the class, the pattern and the reason. -->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.0.1/spotbugs/etc/findbugsfilter.xsd">

  <!-- The macOS relaunch runs this JVM's own binary with a fixed argument
       list; the original arguments are separate list elements and no shell
       parses them. -->
  <Match>
    <Class name="io.github.ajdailey.qcaret.bootstrap.MacRelaunch"/>
    <Bug pattern="COMMAND_INJECTION"/>
  </Match>

  <!-- Natives cache: library names come from the build-time index, match
       [A-Za-z0-9._-]+ and are checked to resolve inside the directory; the
       directory comes from the settings option, qcaret.home or the per-user cache, and
       is created owner-only. -->
  <Match>
    <Or>
      <Class name="io.github.ajdailey.qcaret.bootstrap.Boot"/>
      <Class name="io.github.ajdailey.qcaret.bootstrap.BootIndex"/>
      <Class name="io.github.ajdailey.qcaret.bootstrap.Natives"/>
      <Class name="io.github.ajdailey.qcaret.bootstrap.NativesLocation"/>
    </Or>
    <Bug pattern="PATH_TRAVERSAL_IN"/>
  </Match>

  <!-- The log formatter writes a logged throwable's stack trace into the
       QCaret log, the record's purpose; nothing reaches a remote peer. -->
  <Match>
    <Class name="io.github.ajdailey.qcaret.launcher.LineFormatter"/>
    <Bug pattern="INFORMATION_EXPOSURE_THROUGH_AN_ERROR_MESSAGE"/>
  </Match>

  <!-- The bootstrap invokes the launcher's main reflectively and rethrows
       whatever exception it ends with. -->
  <Match>
    <Or>
      <Class name="io.github.ajdailey.qcaret.bootstrap.Boot"/>
      <Class name="io.github.ajdailey.qcaret.bootstrap.Main"/>
    </Or>
    <Bug pattern="THROWS_METHOD_THROWS_CLAUSE_BASIC_EXCEPTION"/>
  </Match>
  <!-- Controllers and views keep the collaborators they are constructed
       with; sharing them is the design, not a leak of internal state. -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Controller and view state is confined to the UI thread. A worker
       touches it only inside a runnable posted through UiDispatcher.asyncExec,
       which runs on the UI thread after the Display's queue hands it over. -->
  <Match>
    <Or>
      <Package name="io.github.ajdailey.qcaret.app.controller"/>
      <Package name="io.github.ajdailey.qcaret.ui.swt"/>
      <Class name="io.github.ajdailey.qcaret.app.view.UiUpdateQueue"/>
    </Or>
    <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
  </Match>
  <!-- A document is confined to the thread that edits it: Document.checkThread
       binds the first mutating thread and refuses every other. Workers read
       immutable snapshots, never these fields. -->
  <Match>
    <Class name="io.github.ajdailey.qcaret.core.document.Document"/>
    <Bug pattern="AT_NONATOMIC_64BIT_PRIMITIVE,AT_NONATOMIC_OPERATIONS_ON_SHARED_VARIABLE,AT_STALE_THREAD_WRITE_OF_PRIMITIVE"/>
  </Match>
  <!-- A click on the memory indicator requests a garbage collection, the
       action the user asked for; it runs on a worker. -->
  <Match>
    <Class name="io.github.ajdailey.qcaret.app.controller.MemoryProbe$1"/>
    <Method name="collect"/>
    <Bug pattern="DM_GC"/>
  </Match>
  <!-- The uncaught-exception handler logs the throwable as the throwable
       argument; its stack trace is multi-line by design and its thread name
       passes through LogText.oneLine. -->
  <Match>
    <Class name="io.github.ajdailey.qcaret.launcher.Launcher$FailureLogger"/>
    <Bug pattern="CRLF_INJECTION_LOGS"/>
  </Match>
</FindBugsFilter>
